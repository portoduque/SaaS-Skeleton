# SaaS-Skeleton environment template
# Phase 1 / POR-6 has no required runtime environment variables.
# Later phases will add variables here in the same change that introduces them.
# Never place real secrets in this file.
#
# SONAR_TOKEN is NOT an application environment variable.
# Store it as a GitHub Actions repository secret as documented in README.md.

# Planned future categories (not active yet):
# APP_ENV=development
# POSTGRES_DB=saas_skeleton
# POSTGRES_USER=saas_skeleton
# POSTGRES_PASSWORD=change-me
