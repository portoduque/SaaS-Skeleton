# SaaS-Skeleton local environment template
# Copy to .env and replace every change-me value with a local-only password.
# Never commit .env or real secrets.
#
# SONAR_TOKEN is NOT an application environment variable.
# Store it as a GitHub Actions repository secret as documented in README.md.

POSTGRES_DB=saas_skeleton
POSTGRES_USER=saas_skeleton
POSTGRES_PASSWORD=change-me-app-password
POSTGRES_SUPERUSER_PASSWORD=change-me-admin-password
PGBOUNCER_PORT=6432

DATABASE_URL=jdbc:postgresql://localhost:6432/saas_skeleton
